---
/* Blog search, built on Pagefind (https://pagefind.app). The index is
   generated by `pagefind --site dist` after `astro build`, and only covers
   elements marked `data-pagefind-body` (post pages). It therefore does not
   exist under `astro dev`; the component says so rather than failing. Results
   replace the month grid in place (#blog-browse) while a query or filter is
   active, and the query is kept in ?q= so a search can be shared. */
---

<div id="blog-search" class="mb-10">
  <form role="search" class="flex flex-col md:flex-row gap-3" id="blog-search-form">
    <label class="sr-only" for="blog-search-q">Search the blog</label>
    <input
      id="blog-search-q"
      type="search"
      placeholder="Search the blog"
      autocomplete="off"
      class="grow font-body text-[16px] text-aip-navy bg-aip-white border border-aip-cloud rounded-lg px-4 py-3 focus:outline-none focus:border-aip-teal"
    />
    <label class="sr-only" for="blog-search-category">Category</label>
    <select
      id="blog-search-category"
      class="font-body text-[16px] text-aip-navy bg-aip-white border border-aip-cloud rounded-lg px-4 py-3"
    >
      <option value="">All categories</option>
    </select>
    <label class="sr-only" for="blog-search-month">Month</label>
    <select
      id="blog-search-month"
      class="font-body text-[16px] text-aip-navy bg-aip-white border border-aip-cloud rounded-lg px-4 py-3"
    >
      <option value="">All months</option>
    </select>
  </form>
  <p
    id="blog-search-status"
    class="font-body text-[14px] text-aip-grey mt-4"
    role="status"
    aria-live="polite"
  >
  </p>
  <div id="blog-search-results" class="mt-6 grid grid-cols-1 gap-4"></div>
</div>

<script>
  const q = document.getElementById("blog-search-q") as HTMLInputElement;
  const cat = document.getElementById("blog-search-category") as HTMLSelectElement;
  const month = document.getElementById("blog-search-month") as HTMLSelectElement;
  const status = document.getElementById("blog-search-status")!;
  const results = document.getElementById("blog-search-results")!;
  const browse = document.getElementById("blog-browse");
  const form = document.getElementById("blog-search-form")!;

  let pf: any = null;
  let loading: Promise<any> | null = null;

  function load() {
    loading ??= (async () => {
      try {
        // Built by Pagefind after the Astro build; not a Vite module.
        const url = "/pagefind/pagefind.js";
        pf = await import(/* @vite-ignore */ url);
        await pf.init();
        const filters = await pf.filters();
        for (const [key, el] of [["category", cat], ["month", month]] as const) {
          const values = Object.keys(filters[key] ?? {});
          if (key === "month") values.sort().reverse(); // YYYY-MM, newest first
          for (const v of values) {
            const label =
              key === "month"
                ? new Date(`${v}-01T00:00:00Z`).toLocaleDateString("en-GB", {
                    month: "long",
                    year: "numeric",
                    timeZone: "UTC",
                  })
                : v;
            el.add(new Option(`${label} (${filters[key][v]})`, v));
          }
        }
      } catch {
        pf = null;
      }
      return pf;
    })();
    return loading;
  }

  function esc(s: string) {
    return s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  }

  let run = 0;
  async function search() {
    const term = q.value.trim();
    const filters: Record<string, string> = {};
    if (cat.value) filters.category = cat.value;
    if (month.value) filters.month = month.value;
    const active = term !== "" || Object.keys(filters).length > 0;

    const url = new URL(location.href);
    term ? url.searchParams.set("q", term) : url.searchParams.delete("q");
    history.replaceState(null, "", url);

    if (!active) {
      results.innerHTML = "";
      status.textContent = "";
      browse?.removeAttribute("hidden");
      return;
    }

    const me = ++run;
    status.textContent = "Searching…";
    if (!(await load())) {
      status.textContent = "Search is only available on the published site.";
      return;
    }
    const s = await pf.search(term || null, { filters });
    const items = await Promise.all(s.results.slice(0, 30).map((r: any) => r.data()));
    if (me !== run) return; // a newer search has started

    browse?.setAttribute("hidden", "");
    status.textContent =
      items.length === 0
        ? "No posts match. Try fewer words or clear a filter."
        : `${s.results.length} post${s.results.length === 1 ? "" : "s"} found`;
    results.innerHTML = items
      .map(
        (d: any) => `
        <a href="${esc(d.url)}" class="group bg-aip-white border border-aip-cloud rounded-lg p-6 no-underline hover:border-aip-teal transition-colors block">
          <p class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep">${esc(d.filters?.category?.[0] ?? "")}</p>
          <h3 class="font-heading font-semibold text-h3 text-aip-navy mt-2 group-hover:text-aip-teal-deep transition-colors">${esc(d.meta.title ?? "")}</h3>
          <p class="font-body font-light text-[16px] text-aip-grey mt-2">${d.excerpt}</p>
        </a>`,
      )
      .join("");
  }

  form.addEventListener("submit", (e) => e.preventDefault());
  let t: number;
  q.addEventListener("input", () => {
    clearTimeout(t);
    t = window.setTimeout(search, 150);
  });
  cat.addEventListener("change", search);
  month.addEventListener("change", search);
  [q, cat, month].forEach((el) => el.addEventListener("focus", load, { once: true }));

  const initial = new URL(location.href).searchParams.get("q");
  if (initial) {
    q.value = initial;
    search();
  }
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  ANCHOR_PHRASE,
  SITE_URL,
  TRADING_NAME,
  booking,
} from "../config/site";

/* ------------------------------------------------------------------ */
/*  Organised by buyer question, not by product catalogue (§6.6).      */
/*                                                                     */
/*  A manager arrives asking "how do I get my team using AI", not      */
/*  "show me your product list". So each block leads with the question */
/*  it answers, then the answer, then the price and format.            */
/*                                                                     */
/*  Copy is adapted from the live cal.eu event-type descriptions, so   */
/*  the website and the booking page say the same thing. If you edit   */
/*  one, edit the other.                                               */
/* ------------------------------------------------------------------ */

/* Rates are from bd_offer_definition_v1.4 (16 Jul 2026), §3 Pricing
   Framework — the authoritative source. Note that document's caveat:
   "Corporate rates are indicative — final rates depend on client size
   and scope", which is why the team rates carry a qualifying line.

   The NGO rate is deliberately NOT published here. v1.4 specifies it is
   "issued personally once NGO status is confirmed (typically during the
   Discovery Call) — not published on the booking page." */

const organisational = [
  {
    question: "How do I get my team actually using AI?",
    name: "Half-Day Workshop",
    lede: "A focused half day of hands-on training, built around your team's own workflows rather than generic use cases. Everyone works on a real task from their own job, so the session produces finished work rather than a demonstration.",
    takeaway:
      "Your team leaves with the AI Fluency Framework, a decision-making model for when to delegate to AI and when to stay in control, a branded reference pack of prompting patterns, and a 30-day practice plan.",
    price: "$2,500",
    priceValue: 2500,
    priceNote: "for up to 15 people",
    format: "3.5 hours: 9am–12:30pm or 1pm–4:30pm. In-house or via Zoom.",
    href: booking.halfDay,
    cta: "Book a half-day workshop",
    featured: true,
  },
  {
    question: "We need more than half a day. What does that look like?",
    name: "Full Day Workshop",
    lede: "The same approach with room to go further. A full day lets a team move past first tasks into the work that actually takes time: the recurring, awkward, judgement-heavy jobs where fluency pays for itself.",
    takeaway:
      "Same takeaways as the half day (framework, decision model, reference pack and 30-day practice plan), with considerably more hands-on time on your own workflows.",
    price: "$4,000",
    priceValue: 4000,
    priceNote: "for up to 15 people",
    format: "7 hours: 9am–5pm with a one-hour lunch. In-house or via Zoom.",
    href: booking.fullDay,
    cta: "Book a full-day workshop",
    featured: false,
  },
  {
    question: "We're a small team. Is a full workshop overkill?",
    name: "Small Group Workshop",
    lede: "A half-day workshop for up to five people: small enough to stay genuinely hands-on, big enough that people learn from each other's questions. Often the right first step before committing a whole department.",
    takeaway:
      "Each participant works on a real task from their own job, building practical AI fluency alongside colleagues rather than in isolation.",
    price: "$350",
    priceValue: 350,
    priceNote: "per person, for 4–5 people",
    format: "3.5 hours: 9am–12:30pm or 1pm–4:30pm. In person or via Zoom.",
    href: booking.smallGroup,
    cta: "Book a small group workshop",
    featured: false,
  },
  {
    question: "We did a workshop. How do we make sure it sticks?",
    name: "Team Follow-Up",
    lede: "Ninety minutes for a team that has already been through a workshop. We check progress against the 30-day practice plan, troubleshoot the real use cases people have hit since, and deal with whatever has quietly stalled.",
    takeaway:
      "This is the session that turns a good training day into a change that holds. Most of what goes wrong after a workshop goes wrong in the first month.",
    price: "$1,000",
    priceValue: 1000,
    priceNote: "for up to 15 people",
    format: "90 minutes. In person or via Zoom. For teams who have completed a workshop.",
    href: booking.discoveryCall,
    cta: "Enquire about a follow-up",
    featured: false,
  },
];

const individual = [
  {
    question: "I want to start with myself before involving my team.",
    name: "One-to-One Coaching",
    lede: "A 90-minute session built entirely around your own work. Not a demo, not a generic tutorial. You leave having used Claude to complete a real task from your job, knowing how to prompt it clearly and get consistent results.",
    // $175 confirmed by Tim on 2026-08-31 and published on /book too. The
    // cal.eu event type still carries no price of its own: with no payment
    // app connected, nothing is charged at booking either way.
    price: "$175",
    priceValue: 175,
    priceNote: "per session",
    format: "90 minutes, via Zoom. No prior experience with Claude required.",
    href: booking.oneToOne,
    cta: "Book a 1:1 session",
  },
  {
    question: "I've done a session and want to keep building.",
    name: "Follow-Up One-to-One",
    lede: "A 60-minute follow-up for clients who have completed an initial session. Bring whatever you are working on now, or pick up the thread from last time. We go deeper, refine what is working, and take on the next real task.",
    price: "$120",
    priceValue: 120,
    priceNote: "per session, book as many as you need",
    format: "60 minutes, via Zoom. For returning clients.",
    href: booking.followUp,
    cta: "Book a follow-up",
  },
];

/* ---- Structured data (§5.5) --------------------------------------- */
/* Workshops are typed as Course: it signals a structured programme    */
/* rather than consultancy hours. Coaching is typed as Service.        */
/* Offers are omitted where no price is confirmed — never publish a    */
/* placeholder into structured data.                                   */

const provider = { "@id": `${SITE_URL}/#organization` };

const offer = (value: number | null) =>
  value === null
    ? undefined
    : {
        "@type": "Offer",
        price: value,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      };

const schema = [
  ...organisational.map((s) => ({
    "@context": "https://schema.org",
    "@type": "Course",
    name: s.name,
    description: s.lede,
    provider,
    courseMode: ["Onsite", "Online"],
    offers: offer(s.priceValue),
    hasCourseInstance: {
      "@type": "CourseInstance",
      courseMode: ["Onsite", "Online"],
      courseWorkload: s.name === "Full Day Workshop" ? "PT7H" : "PT3H30M",
    },
  })),
  ...individual.map((s) => ({
    "@context": "https://schema.org",
    "@type": "Service",
    name: s.name,
    description: s.lede,
    provider,
    serviceType: "AI training and coaching",
    offers: offer(s.priceValue),
  })),
];
---

<BaseLayout
  title={`Services and Pricing | ${TRADING_NAME}`}
  description={`AI training for teams and individuals, with prices published. Half-day workshops from $2,500 for up to 15 people, small group from $350 per person, one-to-one from $175. ${ANCHOR_PHRASE}.`}
  schema={schema}
>
  <!-- 1. Hero (White) -->
  <section class="bg-aip-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <p
        class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep mb-3"
      >
        Services
      </p>
      <h1 class="font-heading font-bold text-[32px] md:text-h1 leading-[1.15] text-aip-navy max-w-[820px]">
        How we can work together
      </h1>
      <p
        class="font-body font-light text-[18px] text-aip-grey mt-5 max-w-[640px]"
      >
        Every session is built around the work your people actually do. No
        coding, no prior AI experience, and nothing that depends on buying new
        software. Prices are below, because you should not have to ask.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <Button variant="primary" href={booking.discoveryCall}>
          Book a free discovery call
        </Button>
        <Button variant="secondary" href="#for-individuals">
          I'm buying for myself
        </Button>
      </div>
    </div>
  </section>

  <!-- 2. Organisational offers (Light Cloud) -->
  <section id="for-teams" class="bg-aip-cloud">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <SectionHeading
        eyebrow="For teams"
        heading="Training for organisations"
        subtext="Delivered in-house across Cambodia and Southeast Asia, or online anywhere in Asia and Australasia."
        class="mb-12 max-w-[720px]"
      />

      <div class="flex flex-col gap-6">
        {
          organisational.map((s) => (
            <article
              class:list={[
                "bg-aip-white rounded-lg p-7 md:p-9",
                s.featured
                  ? "border-[1.5px] border-aip-teal"
                  : "border border-aip-cloud",
              ]}
            >
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-2">
                  <h2 class="font-heading font-semibold text-h3 text-aip-navy leading-snug">
                    {s.question}
                  </h2>
                  <p class="font-body font-light text-[16px] text-aip-grey mt-4">
                    {s.lede}
                  </p>
                  <p class="font-body font-light text-[16px] text-aip-grey mt-3">
                    {s.takeaway}
                  </p>
                </div>

                <div class="md:border-l md:border-aip-cloud md:pl-8">
                  <p class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep">
                    {s.name}
                  </p>
                  <p class="font-heading font-bold text-h2 text-aip-navy mt-2">
                    {s.price}
                  </p>
                  <p class="font-body font-light text-[14px] text-aip-grey">
                    {s.priceNote}
                  </p>
                  <p class="font-body font-light text-[14px] text-aip-grey mt-4">
                    {s.format}
                  </p>
                  <div class="mt-6">
                    <Button
                      variant={s.featured ? "primary" : "secondary"}
                      href={s.href}
                    >
                      {s.cta}
                    </Button>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- NGO rate is named but not priced. v1.4 issues it as a private
           code once status is confirmed on the discovery call. -->
      <div
        class="mt-8 rounded-lg bg-aip-teal-tint border border-aip-teal/30 p-7 max-w-[820px]"
      >
        <h3 class="font-heading font-semibold text-h4 text-aip-navy">
          Working for an NGO?
        </h3>
        <p class="font-body font-light text-[16px] text-aip-grey mt-2">
          Registered NGOs based in Cambodia are charged a reduced rate on every
          session on this page. The development sector is a deliberate focus,
          not an afterthought. Mention it on the discovery call and I will
          confirm the rate before you commit to anything.
        </p>
      </div>

      <p class="font-body font-light text-[15px] text-aip-grey mt-6 max-w-[720px]">
        Team rates are indicative. The final figure depends on group size and
        scope, and is confirmed in writing after the discovery call. All prices
        are in US dollars and are net of any local taxes.
      </p>
    </div>
  </section>

  <!-- 3. Individual offers (White) -->
  <section id="for-individuals" class="bg-aip-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <SectionHeading
        eyebrow="For individuals"
        heading="Coaching for one"
        subtext="For professionals who want to build their own fluency first, whether or not a team follows."
        class="mb-12 max-w-[720px]"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          individual.map((s) => (
            <article class="border border-aip-cloud rounded-lg p-7 md:p-8 flex flex-col">
              <h2 class="font-heading font-semibold text-h3 text-aip-navy leading-snug">
                {s.question}
              </h2>
              <p class="font-body font-light text-[16px] text-aip-grey mt-4">
                {s.lede}
              </p>
              <div class="mt-auto pt-6 border-t border-aip-cloud">
                <p class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep">
                  {s.name}
                </p>
                <p class="font-heading font-bold text-h3 text-aip-navy mt-1">
                  {s.price}
                  <span class="font-body font-light text-[14px] text-aip-grey">
                    {" "}
                    {s.priceNote}
                  </span>
                </p>
                <p class="font-body font-light text-[14px] text-aip-grey mt-2">
                  {s.format}
                </p>
                <div class="mt-5">
                  <Button variant="secondary" href={s.href}>
                    {s.cta}
                  </Button>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. CTA band (Deep Navy) -->
  <section class="bg-aip-navy">
    <div class="mx-auto max-w-[1200px] px-6 py-20 text-center">
      <h2 class="font-heading font-bold text-h2 text-aip-white">
        Not sure which of these fits?
      </h2>
      <p
        class="font-body font-light text-[16px] text-aip-white/80 mt-4 max-w-[620px] mx-auto"
      >
        Start with a free 30-minute conversation about where your team is now
        and what you want them to be able to do. No obligation, no jargon.
      </p>
      <div class="mt-8">
        <Button variant="primary" href={booking.discoveryCall}>
          Book a free discovery call
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

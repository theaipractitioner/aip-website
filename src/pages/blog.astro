---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostGrid from "../components/PostGrid.astro";
import BlogSearch from "../components/BlogSearch.astro";
import MonthNav from "../components/MonthNav.astro";
import { getMonthGroups, monthKey, monthLabel } from "../lib/posts";

// The index shows the current month only; earlier months are at /blog/YYYY-MM.
const now = new Date();
const current = monthKey(now);
const groups = await getMonthGroups(now);
// On the 1st or a weekend the new month has no posts yet, but the nav should
// still show it as the page the reader is on.
const months = groups.some((g) => g.key === current)
  ? groups
  : [{ key: current, label: monthLabel(current), posts: [] }, ...groups];
const posts = groups.find((g) => g.key === current)?.posts ?? [];
---

<BaseLayout
  title="Blog | The AI Practitioner"
  description="Notes on using AI properly at work: what the research actually says, what breaks in practice, and what to do about it."
>
  <!-- Page hero (White) -->
  <section class="bg-aip-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <p
        class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep mb-3"
      >
        Blog
      </p>
      <h1 class="font-heading font-bold text-[32px] md:text-h1 leading-[1.15] text-aip-navy">
        Notes &amp; ideas
      </h1>
      <p
        class="font-body font-light text-[18px] text-aip-grey mt-4 max-w-[560px]"
      >
        What the research actually says, what breaks when you put these tools on
        real work, and what to do about it.
      </p>
    </div>
  </section>

  <!-- Post grid (Light Cloud) -->
  <section class="bg-aip-cloud">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <BlogSearch />
      <div id="blog-browse">
        <h2 class="font-heading font-semibold text-h2 text-aip-navy mb-6">
          {monthLabel(current)}
        </h2>
        <div class="mb-10">
          <MonthNav months={months} active={current} current={current} />
        </div>
        {
          posts.length > 0 ? (
            <PostGrid posts={posts} />
          ) : (
            <p class="font-body font-light text-[18px] text-aip-grey">
              No posts yet this month. Browse an earlier month above.
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

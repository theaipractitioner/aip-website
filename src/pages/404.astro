---
// Without this file Astro emits no dist/404.html, and Cloudflare Pages then
// falls back to serving index.html for any unmatched path — with a 200. Every
// typo'd or stale URL became a duplicate of the homepage, which is the exact
// duplicate-content problem the canonical tags in BaseLayout exist to prevent.
// Astro builds this to dist/404.html, which Pages serves with a real 404.
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { getCollection } from "astro:content";

// A wrong URL is most often a mistyped or out-of-date link to a post, so offer
// the three most recent rather than a bare "go home".
const recent = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Page not found | The AI Practitioner" noindex>
  <section class="bg-aip-white">
    <div class="mx-auto max-w-[720px] px-6 py-24">
      <p
        class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep mb-3"
      >
        404
      </p>
      <h1
        class="font-heading font-bold text-[32px] md:text-h1 leading-[1.15] text-aip-navy"
      >
        That page is not here
      </h1>
      <p class="font-body font-light text-[18px] text-aip-grey mt-4">
        The link may be out of date, or the address slightly wrong. Nothing is
        broken at your end.
      </p>

      <div class="flex flex-wrap gap-3 mt-8">
        <Button href="/">Back to the homepage</Button>
        <Button href="/blog" variant="secondary">Read the blog</Button>
      </div>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="bg-aip-cloud">
        <div class="mx-auto max-w-[720px] px-6 py-16">
          <p class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep mb-6">
            Most recent posts
          </p>
          <ul class="flex flex-col gap-5">
            {recent.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="font-heading font-semibold text-h4 text-aip-navy hover:text-aip-teal-deep transition-colors no-underline"
                >
                  {post.data.title}
                </a>
                <p class="font-body font-light text-[15px] text-aip-grey mt-1">
                  {post.data.excerpt}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Contact — The AI Practitioner">
  <!-- Page hero (White) -->
  <section class="bg-aip-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <p
        class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal mb-3"
      >
        Contact
      </p>
      <h1 class="font-heading font-bold text-h1 text-aip-navy">Get in touch</h1>
      <p
        class="font-body font-light text-[18px] text-aip-grey mt-4 max-w-[560px]"
      >
        Placeholder subtext inviting visitors to reach out.
      </p>
    </div>
  </section>

  <!-- Contact form (Light Cloud) — placeholder, no action -->
  <section class="bg-aip-cloud">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <form class="max-w-[560px] flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <label
            for="name"
            class="font-body font-medium text-[13px] uppercase tracking-[0.06em] text-aip-navy"
            >Name</label
          >
          <input
            id="name"
            name="name"
            type="text"
            placeholder="Your name"
            class="font-body text-[16px] text-aip-grey bg-aip-white border border-aip-cloud rounded-md px-4 py-3"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label
            for="email"
            class="font-body font-medium text-[13px] uppercase tracking-[0.06em] text-aip-navy"
            >Email</label
          >
          <input
            id="email"
            name="email"
            type="email"
            placeholder="you@example.com"
            class="font-body text-[16px] text-aip-grey bg-aip-white border border-aip-cloud rounded-md px-4 py-3"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label
            for="message"
            class="font-body font-medium text-[13px] uppercase tracking-[0.06em] text-aip-navy"
            >Message</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="How can I help?"
            class="font-body text-[16px] text-aip-grey bg-aip-white border border-aip-cloud rounded-md px-4 py-3 resize-y"
          ></textarea>
        </div>

        <div>
          <Button variant="primary" type="submit">Send message</Button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { getCollection, render } from "astro:content";
import {
  FOUNDER,
  SITE_URL,
  TRADING_NAME,
  booking,
} from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Article entity. `author` and `publisher` point at the Person and
// Organization already declared site-wide in BaseLayout, so AI engines
// resolve one author across every post rather than a new entity per page.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.publishDate.toISOString().slice(0, 10),
  author: {
    "@type": "Person",
    "@id": `${SITE_URL}/about#person`,
    name: FOUNDER,
  },
  publisher: { "@id": `${SITE_URL}/#organization` },
  mainEntityOfPage: new URL(`/blog/${post.id}`, SITE_URL).href,
  keywords: post.data.tags.join(", "),
  articleSection: post.data.category,
};
---

<BaseLayout
  title={`${post.data.title} | ${TRADING_NAME}`}
  description={post.data.excerpt}
  schema={articleSchema}
>
  <!-- Post header (White) -->
  <article>
    <header class="bg-aip-white">
      <div class="mx-auto max-w-[720px] px-6 pt-20 pb-10">
        <a
          href="/blog"
          class="font-body font-medium text-[13px] text-aip-teal-deep hover:underline inline-block mb-8"
          >&larr; All posts</a
        >
        <p
          class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep mb-3"
        >
          {post.data.category}
        </p>
        <h1
          class="font-heading font-bold text-[32px] md:text-h1 leading-[1.15] text-aip-navy"
        >
          {post.data.title}
        </h1>
        <p class="font-body text-[14px] text-aip-grey/70 mt-6">
          {dateFmt.format(post.data.publishDate)} · {post.data.readingTime} min read
        </p>
      </div>
    </header>

    <!-- Post body (White) -->
    <div class="bg-aip-white">
      <div class="mx-auto max-w-[720px] px-6 pb-20">
        <div class="post-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- Closing CTA (Light Cloud) -->
  <section class="bg-aip-cloud">
    <div class="mx-auto max-w-[720px] px-6 py-16">
      <h2 class="font-heading font-semibold text-h3 text-aip-navy">
        Want this applied to your own work?
      </h2>
      <p class="font-body font-light text-[16px] text-aip-grey mt-3 mb-7">
        A discovery call is a short, no-obligation conversation about where AI
        fits in your team, and where it does not.
      </p>
      <Button href={booking.discoveryCall}>Book a discovery call</Button>
    </div>
  </section>
</BaseLayout>

<!--
  Markdown from the content collection is rendered by <Content />, so its
  elements never receive Astro's scoped-style attribute. These rules must be
  global, and are namespaced under .post-body so they cannot leak into the
  hand-built pages.
-->
<style is:global>
  .post-body {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-aip-grey);
  }

  .post-body > * + * {
    margin-top: 1.5rem;
  }

  .post-body h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: 1.25;
    color: var(--color-aip-navy);
    margin-top: 3rem;
  }

  .post-body h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-h4);
    color: var(--color-aip-navy);
    margin-top: 2.5rem;
  }

  .post-body ul {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .post-body ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .post-body li + li {
    margin-top: 0.5rem;
  }

  .post-body a {
    color: var(--color-aip-teal-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* Source URLs run long and must not force a horizontal scrollbar. */
    overflow-wrap: anywhere;
  }

  .post-body blockquote {
    border-left: 3px solid var(--color-aip-teal);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-aip-navy);
  }

  .post-body hr {
    border: 0;
    border-top: 1px solid var(--color-aip-cloud);
    margin-top: 3rem;
  }

  /* Everything after the closing rule is source attribution: smaller, quieter. */
  .post-body hr ~ p {
    font-size: 14px;
    color: color-mix(in srgb, var(--color-aip-grey) 70%, transparent);
  }

  .post-body strong {
    font-weight: 500;
    color: var(--color-aip-navy);
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const sessions = [
  { title: "Session 1", text: "Placeholder description for the first session." },
  { title: "Session 2", text: "Placeholder description for the second session." },
  { title: "Session 3", text: "Placeholder description for the third session." },
  { title: "Session 4", text: "Placeholder description for the fourth session." },
  { title: "Session 5", text: "Placeholder description for the fifth session." },
];
---

<BaseLayout title="Services — The AI Practitioner">
  <!-- Page hero (White) -->
  <section class="bg-aip-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <p
        class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal mb-3"
      >
        Services
      </p>
      <h1 class="font-heading font-bold text-h1 text-aip-navy">
        How we can work together
      </h1>
      <p
        class="font-body font-light text-[18px] text-aip-grey mt-4 max-w-[560px]"
      >
        Placeholder subtext describing the range of sessions on offer.
      </p>
    </div>
  </section>

  <!-- Service cards (Light Cloud) -->
  <section class="bg-aip-cloud">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          sessions.map((s) => (
            <div class="bg-aip-white border border-aip-cloud rounded-lg p-7">
              <h3 class="font-heading font-semibold text-h3 text-aip-navy">
                {s.title}
              </h3>
              <p class="font-body font-light text-[16px] text-aip-grey mt-3">
                {s.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

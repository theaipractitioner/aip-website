---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedPosts } from "../../lib/posts";
import {
  FOUNDER,
  SITE_URL,
  TRADING_NAME,
  booking,
} from "../../config/site";

// Only published posts get a page. A future-dated post has no URL at all
// until the build that follows its date, so an early link 404s rather than
// quietly revealing next week's copy.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Article entity. `author` and `publisher` point at the Person and
// Organization already declared site-wide in BaseLayout, so AI engines
// resolve one author across every post rather than a new entity per page.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.publishDate.toISOString().slice(0, 10),
  author: {
    "@type": "Person",
    "@id": `${SITE_URL}/about#person`,
    name: FOUNDER,
  },
  publisher: { "@id": `${SITE_URL}/#organization` },
  mainEntityOfPage: new URL(`/blog/${post.id}`, SITE_URL).href,
  image: new URL(post.data.shareImage, SITE_URL).href,
  keywords: post.data.tags.join(", "),
  articleSection: post.data.category,
};
---

<BaseLayout
  title={`${post.data.title} | ${TRADING_NAME}`}
  description={post.data.excerpt}
  image={post.data.shareImage}
  schema={articleSchema}
>
  <!-- Post header (White) -->
  <article>
    <header class="bg-aip-white">
      <div class="mx-auto max-w-[720px] px-6 pt-20 pb-10">
        <a
          href="/blog"
          class="font-body font-medium text-[13px] text-aip-teal-deep hover:underline inline-block mb-8"
          >&larr; All posts</a
        >
        <p
          class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal-deep mb-3"
        >
          {post.data.category}
        </p>
        <h1
          class="font-heading font-bold text-[32px] md:text-h1 leading-[1.15] text-aip-navy"
        >
          {post.data.title}
        </h1>
        <p class="font-body text-[14px] text-aip-grey/70 mt-6">
          {dateFmt.format(post.data.publishDate)} · {post.data.readingTime} min read
        </p>
      </div>

      <!-- Hero photograph. Carries no text of its own by design, so the alt
           text has to describe the picture rather than repeat the headline. -->
      <div class="mx-auto max-w-[960px] px-6 pb-12">
        <Image
          src={post.data.heroImage}
          alt={post.data.heroImageAlt}
          widths={[640, 960, 1600]}
          sizes="(min-width: 960px) 960px, 100vw"
          class="w-full h-auto rounded-lg"
          loading="eager"
        />
      </div>
    </header>

    <!-- Post body (White) -->
    <div class="bg-aip-white">
      <div class="mx-auto max-w-[720px] px-6 pb-20">
        <div class="post-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- Closing CTA (Light Cloud) -->
  <section class="bg-aip-cloud">
    <div class="mx-auto max-w-[720px] px-6 py-16">
      <h2 class="font-heading font-semibold text-h3 text-aip-navy">
        Want this applied to your own work?
      </h2>
      <p class="font-body font-light text-[16px] text-aip-grey mt-3 mb-7">
        A discovery call is a short, no-obligation conversation about where AI
        fits in your team, and where it does not.
      </p>
      <Button href={booking.discoveryCall}>Book a discovery call</Button>
    </div>
  </section>
</BaseLayout>

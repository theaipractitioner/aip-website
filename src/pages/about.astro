---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout title="About — The AI Practitioner">
  <!-- Hero (White) -->
  <section class="bg-aip-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <p
        class="font-body font-medium text-[12px] uppercase tracking-[0.06em] text-aip-teal mb-3"
      >
        About
      </p>
      <h1 class="font-heading font-bold text-h1 text-aip-navy">Tim Parkin</h1>
      <p
        class="font-body font-light text-[18px] text-aip-grey mt-4 max-w-[560px]"
      >
        Placeholder subtext introducing who Tim is and what he does.
      </p>
    </div>
  </section>

  <!-- Story (Light Cloud) -->
  <section class="bg-aip-cloud">
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <SectionHeading
            eyebrow="The story"
            heading="How I got here"
            class="mb-6"
          />
          <p class="font-body font-light text-[16px] text-aip-grey">
            Placeholder paragraph one. Lorem ipsum dolor sit amet, consectetur
            adipiscing elit, sed do eiusmod tempor incididunt ut labore.
          </p>
          <p class="font-body font-light text-[16px] text-aip-grey mt-4">
            Placeholder paragraph two. Ut enim ad minim veniam, quis nostrud
            exercitation ullamco laboris nisi ut aliquip ex ea commodo.
          </p>
        </div>
        <!-- Placeholder image block -->
        <div
          class="aspect-[4/5] rounded-lg bg-aip-white border border-aip-cloud flex items-center justify-center"
        >
          <span class="font-body text-[14px] text-aip-grey/50"
            >[ Photo to come ]</span
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
